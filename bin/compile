#!/usr/bin/env bash

usage() {
  echo 'usage: $(basename $0) [-h|--help]'
  echo
  echo '  OPTIONS:'
  echo
  echo '  -h|--help        show this help text'
  echo '  -b|--binary      filename to write binary to. Default: bread'
  echo '  -c|--class       Java class name to compile. Default: systems.bread.alpha.cms.main'
  echo '  -M|--aliases     override -M opt passed to `clojure`. Default: :cms'
}

POSITIONAL=()
while [[ $# -gt 0 ]]
do
key="$1"

case $key in
    -h|--help)
    # show usage and bail
    usage
    exit
    ;;
    -b|--binary)
    BINARY_NAME=$2
    shift # past argument
    shift # past value
    ;;
    -c|--class)
    JAVA_CLASS=$2
    shift # past argument
    shift # past value
    ;;
    -M|--aliases)
    ALIASES=$2
    shift # past argument
    shift # past value
    ;;
    *)
    POSITIONAL+=("$1") # save it in an array for later
    shift # past argument
    ;;
esac

done
set -- "${POSITIONAL[@]}" # restore positional parameters


JAVA_CLASS=${JAVA_CLASS:-'systems.bread.alpha.cms.main'}
BINARY_NAME=${BINARY_NAME:-'bread'}
ALIASES=${ALIASES:-':cms'}


main() {
  rm -rf classes/*
  rm -rf target/*

  # AOT-compile with the GraalVM JDK, not whatever java is first on PATH.
  # superv.async (a datahike dep) checks at Clojure compile time whether
  # org.graalvm.nativeimage.ImageInfo is loadable; only then does it skip
  # starting its supervisor thread, which native-image otherwise detects in
  # the image heap and aborts with NativeImageError.
  local native_image_bin="$(readlink -f "$(command -v native-image)")"
  GRAALVM_HOME=${GRAALVM_HOME:-$(dirname "$(dirname $native_image_bin)")}
  export JAVA_CMD="${GRAALVM_HOME}/bin/java"

  echo "compiling ${JAVA_CLASS} with ${JAVA_CMD}"
  clojure "-M${ALIASES}" -e "(compile '${JAVA_CLASS})"

  if [[ $? -ne 0 ]] ; then
    echo "Error compiling ${JAVA_CLASS}, aborting"
    exit 1
  fi

  echo "compiling native binary \`${BINARY_NAME}\` from ${JAVA_CLASS}"
  native-image \
    -cp "$(clojure -Spath -M${ALIASES})":classes \
    -o "$BINARY_NAME" \
    -H:+ReportExceptionStackTraces \
    -H:+PrintClassInitialization \
    --enable-url-protocols=http,https \
    --initialize-at-build-time \
    --verbose \
    --no-fallback \
    --no-server \
    -J-Xmx16g \
    --trace-object-instantiation=java.lang.Thread \
    $JAVA_CLASS
}


main
